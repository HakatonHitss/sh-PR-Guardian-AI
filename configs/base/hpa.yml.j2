apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{nombreAplicacion}}
  namespace: {{nombreEspacio}}
  labels:
    app.kubernetes.io/name: {{nombreAplicacion}}
    app.kubernetes.io/instance: {{nombreAplicacion}}
    app.kubernetes.io/part-of: {{parteDe}}
    app.kubernetes.io/managed-by: argocd
    claro.pe/owner: {{propietario}}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{nombreAplicacion}}
  minReplicas: 1
  maxReplicas: 3
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70