{
  "name": "sh-pr-guardian-ai",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "ng serve",
    "build": "ng build && node scripts/write-federation-manifest.mjs --manifest dist/sh-pr-guardian-ai/browser/federation.manifest.json",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "csp:check": "node scripts/generate-csp.mjs --index dist/sh-pr-guardian-ai/browser/index.html --manifest dist/sh-pr-guardian-ai/browser/federation.manifest.json --connect-origin http://localhost:4201 --allow-localhost --mode report-only --out ./csp-headers.conf",
    "clean": "rm -rf node_modules && rm -rf .angular"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^20.1.7",
    "@angular/animations": "20.3.17",
    "@angular/common": "20.3.17",
    "@angular/compiler": "20.3.17",
    "@angular/core": "20.3.17",
    "@angular/forms": "20.3.17",
    "@angular/platform-browser": "20.3.17",
    "@angular/platform-browser-dynamic": "20.3.17",
    "@angular/router": "20.3.17",
    "es-module-shims": "^1.5.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "1.22.5",
    "@angular-devkit/build-angular": "^20.3.9",
    "@angular/build": "^20.3.9",
    "@angular/cli": "20.3.17",
    "@angular/compiler-cli": "20.3.17",
    "@tailwindcss/postcss": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.0.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-win32-x64-msvc": "^0.114.0"
  }
}
